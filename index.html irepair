  err.style.display='none';btn.textContent='Sending to Mayke...';btn.style.opacity='.6';btn.style.pointerEvents='none';

  const rid='RPR-'+Math.floor(10000+Math.random()*90000);
  const s=ST.svc, fn=v('fname'), ln=v('lname'), ph=v('phone'), addr=v('address'), tag=v('tag'), brand=document.getElementById('brand').value;
  const params={booking_id:rid,client_name:fn+' '+ln,client_email:v('email'),phone:ph,area:ST.area?ST.area.name:'',service:s?s.name:'',
    date:GCAL_BOOKING_URL?'Customer is picking a time on Google Calendar':'Not scheduled yet: call the customer to set a time',
    time:GCAL_BOOKING_URL?'See Google Calendar':'To be arranged',address:addr,brand:brand||'Not specified',
    message:(v('notes')||'No description')+'\n\nData tag (model/serial): '+(tag||'Not provided')+'\nTrip fee: $150, paid at the appointment'};
  try{
    if(typeof emailjs==='undefined') throw new Error('EmailJS did not load');
    await withTimeout(emailjs.send('service_8m5ls3o','template_n13pdvs',params),15000);
  }catch(e){
    console.error('Booking email failed:',e);
    btnReset();
    const body='Hi Mayke, the website booking did not go through. I need '+(s?s.name:'a repair')+'. Name: '+fn+' '+ln+', phone '+ph+', address '+addr+(tag?', data tag '+tag:'')+'.';
    err.innerHTML='<strong>Sorry, your request did not go through.</strong>Please call or text Mayke directly at <b>'+MAYKE_PHONE_DISPLAY+'</b> to book. <b>If this is an emergency, call now.</b>'+contactButtons(body);
    err.style.display='block';err.scrollIntoView({behavior:'smooth',block:'nearest'});
    toast('Request failed. Please call '+MAYKE_PHONE_DISPLAY+'.','⚠️');
    return;
  }
  ST.rid=rid;
  const set=(id,val)=>{const e=document.getElementById(id);if(e)e.textContent=val;};
  set('cf-id',rid);set('cf-svc',s?s.name:'');set('cf-name',fn+' '+ln);set('cf-addr',addr);
