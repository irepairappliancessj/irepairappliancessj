  width:6px;height:6px;border-radius:50%;
  background:#22C55E;display:inline-block;
  box-shadow:0 0 6px #22C55E;
}
.chat-messages{
  flex:1;overflow-y:auto;
  padding:16px;
  display:flex;flex-direction:column;gap:10px;
  scroll-behavior:smooth;
}
.chat-messages::-webkit-scrollbar{width:3px;}
.chat-messages::-webkit-scrollbar-track{background:transparent;}
.chat-messages::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.1);border-radius:2px;}
.chat-msg{
  max-width:85%;
  font-family:'Inter',sans-serif;
  font-size:13px;line-height:1.6;
  padding:10px 13px;
  border-radius:10px;
  animation:msgIn .25s ease both;
}
@keyframes msgIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.chat-msg.bot{
  background:#1A1A1A;
  color:rgba(255,255,255,0.85);
  border:1px solid rgba(255,255,255,0.06);
  align-self:flex-start;
  border-bottom-left-radius:3px;
}
.chat-msg.user{
  background:var(--mred);
  color:#fff;
  align-self:flex-end;
  border-bottom-right-radius:3px;
}
.chat-typing{
  display:flex;gap:4px;align-items:center;
  padding:12px 14px;
  background:#1A1A1A;border:1px solid rgba(255,255,255,0.06);
  border-radius:10px;border-bottom-left-radius:3px;
  align-self:flex-start;
  width:52px;
}
.chat-typing span{
  width:6px;height:6px;border-radius:50%;
  background:rgba(255,255,255,0.3);
  animation:typingDot 1.2s ease-in-out infinite;
}
.chat-typing span:nth-child(2){animation-delay:.2s;}
.chat-typing span:nth-child(3){animation-delay:.4s;}
@keyframes typingDot{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-5px);background:rgba(255,255,255,0.7);}}
.chat-quick-replies{
  display:flex;flex-direction:column;gap:6px;
  margin-top:6px;align-self:flex-start;width:100%;
}
.chat-qr{
  font-family:'Inter',sans-serif;
  font-size:12px;font-weight:500;
  padding:8px 13px;
  background:transparent;
  border:1px solid rgba(255,255,255,0.1);
  border-radius:8px;
  color:rgba(255,255,255,0.7);
  cursor:pointer;
  text-align:left;
  transition:all .2s;
  width:100%;
}
.chat-qr:hover{
  background:rgba(255,255,255,0.04);
  border-color:rgba(255,255,255,0.2);
  color:#fff;
}
.chat-qr.emergency{
  border-color:rgba(200,16,46,.4);
  color:rgba(220,80,80,0.9);
  background:rgba(200,16,46,0.06);
}
.chat-qr.emergency:hover{
  background:rgba(200,16,46,0.12);
  border-color:rgba(200,16,46,.6);
  color:#fff;
}
.chat-input-row{
  border-top:1px solid rgba(255,255,255,0.06);
  padding:12px 14px;
  display:flex;gap:8px;align-items:center;
  flex-shrink:0;
  background:#0D0D0D;
}
#chat-input{
  flex:1;background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:8px;
  padding:9px 12px;
  font-family:'Inter',sans-serif;
  font-size:13px;color:rgba(255,255,255,0.85);
  outline:none;
  transition:border-color .2s;
  resize:none;
}
#chat-input::placeholder{color:rgba(255,255,255,0.25);}
#chat-input:focus{border-color:rgba(200,16,46,0.4);}
#chat-send{
  width:34px;height:34px;border-radius:8px;
  background:var(--mred);border:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;transition:all .2s;
}
#chat-send:hover{background:var(--mred2);}
@media(max-width:480px){
  #chat-window{width:calc(100vw - 32px);right:16px;bottom:80px;}
  #chat-btn{right:16px;bottom:16px;}
  #chat-pulse{right:16px;bottom:16px;}
}
</style>

<!-- Pulse ring -->
<div id="chat-pulse"></div>

<!-- Chat toggle button -->
<button id="chat-btn" onclick="toggleChat()" aria-label="Chat with us">
  <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
</button>

<!-- Chat window -->
<div id="chat-window">
  <!-- Header -->
  <div class="chat-header">
    <div class="chat-avatar">🔧</div>
    <div class="chat-header-info">
      <h4>iRepair Appliances</h4>
      <p><span class="chat-online-dot"></span> All brands · Available now</p>
    </div>
  </div>

  <!-- Messages -->
  <div class="chat-messages" id="chat-messages"></div>

  <!-- Input -->
  <div class="chat-input-row">
    <input id="chat-input" placeholder="Ask a question..." onkeydown="if(event.key==='Enter')sendChat()">
    <button id="chat-send" onclick="sendChat()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </div>
</div>

<script>
// ── CHATBOT ──────────────────────────────────────────────────────────────────
const TECH_PHONE = '14084550729';
const TECH_SMS_BODY = encodeURIComponent('EMERGENCY: I need urgent appliance repair. Please call or text me back as soon as possible.');

let chatOpen = false;
let chatReady = false;

const QUICK_REPLIES = [
  { label: '💰 What are your rates?',          key: 'rates' },
  { label: '🔵 Which brands do you service?', key: 'models' },
  { label: '📅 How do I book an appointment?',  key: 'book' },
  { label: '🛡️ What does the trip fee cover?',  key: 'tripfee' },
  { label: '⏰ What are your service areas?',    key: 'areas' },
  { label: '🚨 Emergency — Text Technician',    key: 'emergency', cls: 'emergency' },
];

const BOT_ANSWERS = {
  rates: `Our rate is <strong>$150 per hour</strong>, billed based on actual time worked — not per job. There's also a one-time <strong>$150 trip fee</strong>, paid at your appointment, which covers your full diagnostic, 90-day warranty, liability insurance, and workmanship guarantee.`,
  models: `We service <strong>all major appliance brands and models</strong> — dishwashers, washing machines, dryers, refrigerators, ovens, microwaves, coffee machines, and more. Not sure about yours? Book anyway and we'll confirm.`,
  book: `Booking is easy! Click <strong>Book a Repair</strong> in the menu, choose your appliance, enter your details, and pick an open time on Mayke's calendar. Nothing is paid online: the $150 trip fee is paid at your appointment. Need it fast? Text (408) 455-0729.`,
  tripfee: `The <strong>$150 trip fee</strong> is paid at your appointment and covers:
• Full appliance diagnostic
• 90-day repair warranty
• Liability insurance during service
• Workmanship guarantee on all prior repairs

Hourly labour is billed separately after the job.`,
  areas: `We serve the <strong>San Jose area</strong> and surrounding cities including Los Gatos, Campbell, Saratoga, Cupertino, Milpitas, Los Altos, and Santa Clara. Don't see your city? Book anyway and we'll confirm availability.`,
  emergency: null, // handled separately
};

function toggleChat() {
  chatOpen = !chatOpen;
  document.getElementById('chat-btn').classList.toggle('open', chatOpen);
  document.getElementById('chat-window').classList.toggle('open', chatOpen);
  if (chatOpen && !chatReady) {
    chatReady = true;
    setTimeout(() => {
      addBotMessage(`Hi there! 👋 I'm the iRepair assistant. How can I help you today?`);
      setTimeout(() => addQuickReplies(), 500);
    }, 300);
  }
  if (chatOpen) {
    setTimeout(() => document.getElementById('chat-input').focus(), 350);
  }
}

function addBotMessage(html, delay = 0) {
  const msgs = document.getElementById('chat-messages');
  // Show typing indicator
  const typing = document.createElement('div');
  typing.className = 'chat-typing';
  typing.innerHTML = '<span></span><span></span><span></span>';
  msgs.appendChild(typing);
  msgs.scrollTop = msgs.scrollHeight;
  setTimeout(() => {
    typing.remove();
    const msg = document.createElement('div');
    msg.className = 'chat-msg bot';
    msg.innerHTML = html.replace(/\n/g, '<br>');
    msgs.appendChild(msg);
    msgs.scrollTop = msgs.scrollHeight;
  }, delay || 800);
}

function addUserMessage(text) {
  const msgs = document.getElementById('chat-messages');
  const msg = document.createElement('div');
  msg.className = 'chat-msg user';
  msg.textContent = text;
  msgs.appendChild(msg);
  msgs.scrollTop = msgs.scrollHeight;
}

function addQuickReplies() {
  const msgs = document.getElementById('chat-messages');
  const wrap = document.createElement('div');
  wrap.className = 'chat-quick-replies';
  wrap.id = 'chat-qr-wrap';
  QUICK_REPLIES.forEach(qr => {
    const btn = document.createElement('button');
    btn.className = 'chat-qr' + (qr.cls ? ' ' + qr.cls : '');
    btn.textContent = qr.label;
    btn.onclick = () => handleQuickReply(qr.key, qr.label);
    wrap.appendChild(btn);
  });
  msgs.appendChild(wrap);
  msgs.scrollTop = msgs.scrollHeight;
}

function handleQuickReply(key, label) {
  // Remove quick replies
  const qrWrap = document.getElementById('chat-qr-wrap');
  if (qrWrap) qrWrap.remove();

  if (key === 'emergency') {
    addUserMessage('🚨 Emergency — I need urgent help!');
    addBotMessage(`I'm connecting you with our technician right now. Tap below to send an emergency text directly to your technician — they will call or text you back immediately.`, 600);
    setTimeout(() => {
      const msgs = document.getElementById('chat-messages');
      const btn = document.createElement('a');
      btn.href = `sms:+${TECH_PHONE}?body=${TECH_SMS_BODY}`;
      btn.style.cssText = 'display:block;background:#C8102E;color:#fff;font-family:Inter,sans-serif;font-size:13px;font-weight:600;padding:12px 16px;border-radius:8px;text-decoration:none;text-align:center;margin-top:4px;letter-spacing:.05em;transition:background .2s;';
      btn.innerHTML = '🚨 Send Emergency Text to Technician';
      btn.onmouseover = () => btn.style.background = '#A50D26';
      btn.onmouseout = () => btn.style.background = '#C8102E';
      msgs.appendChild(btn);
      setTimeout(() => {
        addBotMessage(`You can also call us directly: <a href="tel:+${TECH_PHONE}" style="color:rgba(200,80,80,0.9);font-weight:600;">+1 (408) 455-0729</a>. We respond to emergencies as quickly as possible.`, 400);
        setTimeout(() => addFollowUp(), 1200);
      }, 600);
      msgs.scrollTop = msgs.scrollHeight;
    }, 1400);
    return;
  }

  addUserMessage(label);
  const answer = BOT_ANSWERS[key];
  if (answer) {
    addBotMessage(answer, 800);
    setTimeout(() => addFollowUp(), 1800);
  }
}

function addFollowUp() {
  const msgs = document.getElementById('chat-messages');
  const wrap = document.createElement('div');
  wrap.className = 'chat-quick-replies';
  const options = [
    { label: '📅 Book a Repair', action: () => { toggleChat(); gv('booking'); } },
    { label: '❓ Ask another question', action: () => { const w=document.getElementById('chat-qr-wrap'); if(w)w.remove(); addQuickReplies(); } },
    { label: '🚨 Emergency — Text Technician', action: () => handleQuickReply('emergency','🚨 Emergency'), cls: 'emergency' },
  ];
  options.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'chat-qr' + (opt.cls ? ' ' + opt.cls : '');
    btn.textContent = opt.label;
    btn.onclick = opt.action;
    wrap.appendChild(btn);
  });
  msgs.appendChild(wrap);
  msgs.scrollTop = msgs.scrollHeight;
}

async function sendChat() {
  const input = document.getElementById('chat-input');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';

  // Remove existing quick replies
  const qrWrap = document.getElementById('chat-qr-wrap');
  if (qrWrap) qrWrap.remove();

  addUserMessage(text);

  // Check for emergency keywords
  const emergencyWords = ['emergency','urgent','leak','flood','flooding','smoke','fire','sparks','burning','broken','immediately','asap','now'];
  if (emergencyWords.some(w => text.toLowerCase().includes(w))) {
    handleQuickReply('emergency', '🚨 Emergency');
    return;
  }

  // Show typing then call Claude API
  const msgs = document.getElementById('chat-messages');
  const typing = document.createElement('div');
  typing.className = 'chat-typing';
  typing.id = 'chat-typing-ai';
  typing.innerHTML = '<span></span><span></span><span></span>';
  msgs.appendChild(typing);
  msgs.scrollTop = msgs.scrollHeight;

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: `You are the friendly AI assistant for iRepair Appliances, a premium appliance repair company in San Jose, CA that services all major brands.

Key facts to always use:
- We service ALL major appliance brands and models (not limited to any one brand)
- Rate: $150 per hour, NOT per job
- Trip fee: $150, paid at the appointment, nothing is paid online (covers diagnostic, 90-day warranty, liability insurance, workmanship guarantee on prior repairs)
- Customers pick an open time on Mayke's Google Calendar booking page; for fast or emergency service they text (408) 455-0729 with full name, address and appliance data tag
- Service areas: San Jose, Los Gatos, Campbell, Saratoga, Cupertino, Milpitas, Los Altos, Santa Clara
- Services: Dishwasher, Washing Machine, Dryer, Refrigerator, Oven/Range, Microwave, Coffee Machine, and other household appliances
- Booking: done online at our website
- Phone: +1 (408) 455-0729
- Website: irepairappliancessj.com

Keep answers concise (2-4 sentences max), warm, and professional. If someone mentions an emergency, leak, flooding, or urgent situation, always direct them to text/call +1 (408) 455-0729 immediately. Never make up information. If unsure, say to call us.`,
        messages: [{ role: 'user', content: text }]
      })
    });

    const data = await response.json();
    const reply = data.content?.[0]?.text || "I'm not sure about that — please call us at +1 (408) 455-0729 and we'll be happy to help!";

    document.getElementById('chat-typing-ai')?.remove();
    const msg = document.createElement('div');
    msg.className = 'chat-msg bot';
    msg.innerHTML = reply.replace(/\n/g, '<br>');
    msgs.appendChild(msg);
    msgs.scrollTop = msgs.scrollHeight;
    setTimeout(() => addFollowUp(), 600);

  } catch(err) {
    document.getElementById('chat-typing-ai')?.remove();
    addBotMessage("Sorry, I had trouble connecting. Please call us directly at <a href='tel:+14084550729' style='color:rgba(200,80,80,0.9);font-weight:600;'>+1 (408) 455-0729</a> and we'll be happy to help!", 0);
    setTimeout(() => addFollowUp(), 800);
  }
}
</script>

</body>
