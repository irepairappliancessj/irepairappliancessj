<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>iRepair Appliances — All-Brand Appliance Repair · San Jose</title>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script>emailjs.init("WmxYq4x3lIE0jywCy");</script>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --ink:#0B2540;--ink2:#33415A;--muted:#5B6777;--line:#E3E7EE;--soft:#F4F6FA;--white:#fff;
  --mred:#C8102E;--mred2:#A50D26;--og:rgba(200,16,46,0.08);--orange:#C8102E;--orange2:#A50D26;
  --navy:#fff;--border:var(--line);--border2:var(--line);
  --success:#16A34A;--r:6px;--rlg:14px;
  --blue:#1A3A6B;--blue2:#2451A0;--blue-light:rgba(36,81,160,0.10);
  --shadow:0 10px 30px rgba(11,37,64,0.08);
}
html{scroll-behavior:smooth;}
body{font-family:'Inter',sans-serif;background:#fff;color:var(--ink);min-height:100vh;font-size:15px;line-height:1.6;overflow-x:hidden;}
h1,h2,h3,h4,h5{font-family:'Poppins',sans-serif;font-weight:700;letter-spacing:-.01em;line-height:1.15;color:var(--ink);}
a{color:inherit;}
.wrap{max-width:1200px;margin:0 auto;padding:0 24px;}

/* TOP BAR + HEADER */
.topbar{background:var(--ink);color:rgba(255,255,255,.85);font-size:13px;}
.topbar .wrap{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:38px;flex-wrap:wrap;}
.topbar a{color:#fff;text-decoration:none;font-weight:600;}
.topbar{background:var(--mred);}
.topbar .wrap{justify-content:center!important;padding-top:8px;padding-bottom:8px;}
.topbar-alert{color:#fff!important;font-weight:500!important;font-size:14px;text-align:center;line-height:1.45;display:flex;gap:8px;align-items:flex-start;}
.topbar-alert b{font-weight:700;text-decoration:underline;text-underline-offset:3px;}
.topbar-items{display:flex;gap:22px;flex-wrap:wrap;}
.topbar-items span::before{content:'✓';color:#FF8FA0;margin-right:7px;font-weight:700;}
nav{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:200;}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:76px;gap:20px;}
.logo{font-family:'Poppins',sans-serif;font-weight:800;font-size:24px;color:var(--ink);line-height:1;cursor:pointer;display:flex;align-items:center;gap:10px;}
.logo-mark{width:40px;height:40px;border-radius:10px;background:var(--mred);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.logo em{font-style:normal;color:var(--mred);}
.logo span{display:block;font-size:10px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);margin-top:4px;}
.nav-links{display:flex;gap:28px;align-items:center;}
.nav-links a{color:var(--ink2);text-decoration:none;font-size:14px;font-weight:500;transition:color .2s;}
.nav-links a:hover{color:var(--mred);}
.nav-actions{display:flex;gap:10px;align-items:center;}
.nav-phone{display:inline-flex;align-items:center;gap:8px;color:var(--ink);text-decoration:none;font-family:'Poppins',sans-serif;font-weight:700;font-size:16px;padding:10px 14px;border-radius:8px;white-space:nowrap;}
.nav-phone:hover{background:var(--soft);}
.nav-cta{background:var(--mred);color:#fff!important;padding:12px 22px;border-radius:8px;font-family:'Poppins',sans-serif;font-size:14px;font-weight:600;text-decoration:none;white-space:nowrap;transition:all .2s;}
.nav-cta:hover{background:var(--mred2);box-shadow:0 8px 20px rgba(200,16,46,.28);}

/* BUTTONS */
.btn-primary{background:var(--mred);color:#fff;padding:15px 28px;border:none;border-radius:8px;font-family:'Poppins',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:10px;}
.btn-primary::after{content:'→';transition:transform .2s;}
.btn-primary:hover{background:var(--mred2);box-shadow:0 10px 24px rgba(200,16,46,.28);}
.btn-primary:hover::after{transform:translateX(4px);}
.btn-outline{background:#fff;color:var(--ink);padding:14px 28px;border:1.5px solid var(--ink);border-radius:8px;font-family:'Poppins',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;text-decoration:none;display:inline-flex;align-items:center;gap:8px;}
.btn-outline:hover{background:var(--ink);color:#fff;}

/* HERO */
.hero{background:linear-gradient(180deg,#F4F6FA 0%,#fff 100%);padding:56px 0 48px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;right:-180px;top:-220px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(200,16,46,.10),rgba(200,16,46,0) 68%);pointer-events:none;}
.hero-grid{display:grid;grid-template-columns:1.02fr 1fr;gap:48px;align-items:center;position:relative;}
.eyebrow{font-family:'Poppins',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--mred);margin-bottom:14px;}
.hero h1{font-size:clamp(34px,4.6vw,56px);font-weight:800;letter-spacing:-.025em;line-height:1.06;margin-bottom:18px;}
.hero h1 .acc{color:var(--mred);}
.hero-sub{font-size:17px;color:var(--ink2);max-width:520px;margin-bottom:28px;line-height:1.7;}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px;}
.hero-points{display:flex;gap:10px 22px;flex-wrap:wrap;font-size:14px;font-weight:500;color:var(--ink2);}
.hero-points span{display:inline-flex;align-items:center;gap:8px;}
.hero-points span::before{content:'✓';width:20px;height:20px;border-radius:50%;background:var(--og);color:var(--mred);font-size:11px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;}
.hero-brands{background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:26px 26px 22px;}
.hero-brands-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:16px;}
.hero-brands-head h2{font-size:19px;}
.hero-brands-head a{font-size:13px;font-weight:600;color:var(--mred);text-decoration:none;white-space:nowrap;}
.brand-grid{display:grid;gap:10px;}
.brand-grid.sm{grid-template-columns:repeat(3,1fr);}
.brand-grid.lg{grid-template-columns:repeat(7,1fr);gap:14px;}
.brand-tile{background:#fff;border:1px solid var(--line);border-radius:12px;display:flex;align-items:center;justify-content:center;padding:14px 16px;height:78px;transition:all .2s;}
.brand-grid.lg .brand-tile{height:104px;padding:20px 18px;}
.brand-tile:hover{border-color:var(--ink);box-shadow:var(--shadow);transform:translateY(-2px);}
.brand-tile{flex-direction:column;gap:8px;}
.brand-grid.sm .brand-tile{height:104px;padding:12px 12px 10px;}
.brand-logo{flex:1;min-height:0;width:100%;display:flex;align-items:center;justify-content:center;}
.brand-tile img{max-width:88%;max-height:44px;object-fit:contain;display:block;}
.brand-name{font-size:12px;font-weight:600;color:var(--ink2);letter-spacing:.01em;line-height:1;}
.brand-fallback{font-family:'Poppins',sans-serif;font-weight:800;font-size:17px;letter-spacing:.02em;color:var(--ink);text-align:center;}
.brand-more{font-family:'Poppins',sans-serif;font-weight:600;font-size:13px;color:var(--mred);text-align:center;line-height:1.3;}
.brand-note{font-size:12px;color:var(--muted);margin-top:18px;line-height:1.6;}

/* ADVANTAGES STRIP */
.adv{background:var(--ink);color:#fff;}
.adv .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:0;}
.adv-item{display:flex;align-items:center;gap:14px;padding:24px 20px;border-left:1px solid rgba(255,255,255,.12);}
.adv-item:first-child{border-left:none;padding-left:0;}
.adv-ic{width:42px;height:42px;border-radius:10px;background:rgba(255,255,255,.10);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.adv-item strong{display:block;font-family:'Poppins',sans-serif;font-size:15px;font-weight:600;line-height:1.3;}
.adv-item small{font-size:12.5px;color:rgba(255,255,255,.65);}

/* SECTIONS */
.section{padding:84px 0;}
.section.soft{background:var(--soft);}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:40px;flex-wrap:wrap;}
.sec-head.center{flex-direction:column;align-items:center;text-align:center;}
.sec-eye{font-family:'Poppins',sans-serif;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--mred);font-weight:600;margin-bottom:10px;}
.sec-head h2{font-size:clamp(28px,3.4vw,40px);font-weight:800;letter-spacing:-.02em;}
.sec-head p{color:var(--muted);max-width:620px;margin-top:10px;font-size:16px;}

/* SERVICE CARDS */
.svc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px;}
.svc-card{background:#fff;border:1px solid var(--line);border-radius:var(--rlg);cursor:pointer;transition:all .2s;position:relative;overflow:hidden;}
.svc-card:hover{border-color:var(--ink);box-shadow:var(--shadow);transform:translateY(-3px);}
.svc-card:hover .svc-card-arrow{opacity:1;transform:translateX(0);}
.svc-card.selected{border-color:var(--mred);box-shadow:0 0 0 2px var(--mred);}
.svc-card.selected .svc-chk{opacity:1;transform:scale(1);}
.svc-chk{position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--mred);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;opacity:0;transform:scale(.5);transition:all .2s;z-index:2;}
.svc-img-wrap{width:100%;height:170px;overflow:hidden;border-bottom:1px solid var(--line);background:var(--soft);}
.svc-img-wrap svg{width:100%;height:100%;display:block;}
.svc-card-body{padding:20px 22px 20px;}
.svc-card h3{font-size:18px;font-weight:700;margin-bottom:8px;}
.svc-card p{font-size:13.5px;color:var(--muted);margin-bottom:16px;line-height:1.6;}
.svc-meta{display:flex;justify-content:space-between;align-items:center;}
.svc-price{font-size:13px;font-weight:500;color:var(--muted);}
.svc-price strong{color:var(--mred);font-family:'Poppins',sans-serif;font-weight:700;font-size:17px;}
.svc-card-arrow{font-size:16px;color:var(--mred);opacity:0;transform:translateX(-4px);transition:all .2s;}
.svc-tag{position:absolute;top:12px;left:12px;background:var(--mred);color:#fff;font-family:'Poppins',sans-serif;font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:4px 10px;border-radius:20px;z-index:2;}
.brand-banner{background:#fff;border:1px solid var(--line);border-left:4px solid var(--mred);border-radius:10px;padding:18px 22px;margin-bottom:28px;display:flex;align-items:center;gap:16px;}
.brand-banner p{font-size:14px;color:var(--ink2);line-height:1.6;margin:0;}
.brand-banner p strong{color:var(--ink);}

/* MEET THE OWNER */
.owner{display:grid;grid-template-columns:380px 1fr;gap:56px;align-items:center;}
.owner-photo{position:relative;aspect-ratio:4/5;border-radius:20px;background:linear-gradient(160deg,#0B2540 0%,#16375E 60%,#1E4A7C 100%);display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:var(--shadow);}
.owner-photo::before{content:'';position:absolute;width:150%;height:150%;border:1px solid rgba(255,255,255,.10);border-radius:50%;top:-60%;right:-70%;}
.owner-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;}
.owner-initials{font-family:'Poppins',sans-serif;font-weight:800;font-size:110px;color:#fff;letter-spacing:-.04em;position:relative;}
.owner-badge{position:absolute;left:18px;bottom:18px;right:18px;background:#fff;border-radius:12px;padding:14px 16px;display:flex;align-items:center;gap:12px;}
.owner-badge strong{display:block;font-family:'Poppins',sans-serif;font-size:16px;color:var(--ink);line-height:1.2;}
.owner-badge small{font-size:12.5px;color:var(--muted);}
.owner-dot{width:10px;height:10px;border-radius:50%;background:var(--mred);flex-shrink:0;}
.owner h2{font-size:clamp(28px,3.4vw,40px);font-weight:800;letter-spacing:-.02em;margin-bottom:6px;}
.owner-role{font-family:'Poppins',sans-serif;font-weight:600;color:var(--mred);font-size:15px;margin-bottom:20px;}
.owner p{color:var(--ink2);font-size:16px;line-height:1.8;margin-bottom:16px;max-width:620px;}
.owner blockquote{border-left:4px solid var(--mred);padding:6px 0 6px 20px;margin:24px 0 28px;font-family:'Poppins',sans-serif;font-size:19px;font-weight:500;line-height:1.5;color:var(--ink);max-width:600px;}
.owner blockquote cite{display:block;font-family:'Inter',sans-serif;font-style:normal;font-size:13.5px;font-weight:500;color:var(--muted);margin-top:10px;}
.owner-facts{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:28px;}
.owner-facts span{background:var(--soft);border:1px solid var(--line);border-radius:30px;padding:8px 16px;font-size:13.5px;font-weight:500;color:var(--ink2);}
.section.soft .owner-facts span{background:#fff;}

/* AREA + CTA + FOOTER */
.city-chips{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;max-width:860px;margin:0 auto;}
.city-chips span{background:#fff;border:1px solid var(--line);border-radius:30px;padding:10px 18px;font-size:14px;font-weight:500;color:var(--ink2);display:inline-flex;align-items:center;gap:8px;}
.city-chips span::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--mred);}
.cta-band{background:var(--mred);color:#fff;padding:56px 0;}
.cta-band .wrap{display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap;}
.cta-band h2{color:#fff;font-size:clamp(26px,3vw,36px);font-weight:800;}
.cta-band p{color:rgba(255,255,255,.88);margin-top:6px;font-size:16px;}
.cta-btns{display:flex;gap:12px;flex-wrap:wrap;}
.btn-white{background:#fff;color:var(--mred);padding:15px 28px;border-radius:8px;font-family:'Poppins',sans-serif;font-weight:700;font-size:14px;text-decoration:none;display:inline-flex;align-items:center;gap:8px;}
.btn-ghost{border:1.5px solid rgba(255,255,255,.7);color:#fff;padding:14px 28px;border-radius:8px;font-family:'Poppins',sans-serif;font-weight:600;font-size:14px;text-decoration:none;}
.btn-ghost:hover{background:rgba(255,255,255,.12);}
footer{background:var(--ink);color:rgba(255,255,255,.7);padding:56px 0 28px;font-size:14px;}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.1fr;gap:36px;margin-bottom:36px;}
footer h4{color:#fff;font-size:14px;font-weight:600;margin-bottom:14px;letter-spacing:.02em;}
footer a{color:rgba(255,255,255,.7);text-decoration:none;display:block;margin-bottom:8px;}
footer a:hover{color:#fff;}
footer .logo{color:#fff;margin-bottom:14px;cursor:default;}
footer .logo span{color:rgba(255,255,255,.55);}
.foot-phone{font-family:'Poppins',sans-serif;font-weight:700;font-size:20px;color:#fff!important;}
.foot-bottom{border-top:1px solid rgba(255,255,255,.12);padding-top:22px;font-size:12.5px;color:rgba(255,255,255,.5);line-height:1.7;}

/* BOOKING */
.book-section{background:var(--soft);padding:64px 24px 84px;}
.book-wrap{max-width:1100px;margin:0 auto;}
.step-bar{display:flex;align-items:center;margin-bottom:48px;padding-bottom:32px;border-bottom:1px solid var(--line);}
.si{display:flex;align-items:center;gap:12px;flex:1;}
.si-num{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Poppins',sans-serif;font-size:13px;font-weight:600;background:#fff;border:1px solid var(--line);color:var(--muted);flex-shrink:0;transition:all .3s;}
.si.active .si-num{background:var(--mred);border-color:var(--mred);color:#fff;}
.si.done .si-num{background:rgba(22,163,74,.12);border-color:rgba(22,163,74,.4);color:#16A34A;}
.si-lbl{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:500;}
.si.active .si-lbl{color:var(--ink);font-weight:700;}
.step-line{flex:1;height:1px;background:var(--line);max-width:80px;}
.blayout{display:grid;grid-template-columns:1fr 320px;gap:32px;}
.area-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin-bottom:32px;}
.area-card{background:#fff;border:1px solid var(--line);border-radius:var(--rlg);padding:16px 18px;cursor:pointer;position:relative;}
.area-card.selected{border-color:var(--mred);}
.area-chk{position:absolute;top:10px;right:10px;width:18px;height:18px;background:var(--mred);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;opacity:0;}
.area-card.selected .area-chk{opacity:1;}
.area-name{font-family:'Poppins',sans-serif;font-size:16px;font-weight:700;}
.area-meta{font-size:12px;color:var(--muted);}
.cal-panel{background:#fff;border:1px solid var(--line);border-radius:var(--rlg);padding:26px;}
.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
.cal-head h3{font-size:20px;}
.cnbtn{width:34px;height:34px;background:#fff;border:1px solid var(--line);border-radius:8px;color:var(--ink);cursor:pointer;font-size:14px;transition:all .2s;display:flex;align-items:center;justify-content:center;}
.cnbtn:hover{background:var(--mred);border-color:var(--mred);color:#fff;}
.cgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;}
.clbl{text-align:center;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:8px 0 12px;}
.cday{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:14px;border-radius:8px;cursor:pointer;transition:all .15s;color:var(--ink);border:1px solid transparent;position:relative;}
.cday:hover:not(.dis):not(.emp){background:var(--soft);border-color:var(--line);}
.cday.sel{background:var(--mred)!important;color:#fff!important;border-color:var(--mred);font-weight:600;}
.cday.today{border-color:var(--mred);color:var(--mred);font-weight:600;}
.cday.dis{color:#C3CAD5;cursor:not-allowed;}
.cday.emp{cursor:default;}
.cday.hslots::after{content:'';position:absolute;bottom:4px;left:50%;transform:translateX(-50%);width:4px;height:4px;background:var(--mred);border-radius:50%;}
.cday.sel::after{background:rgba(255,255,255,.8);}
.cday.beyond{color:#A6AFBD;cursor:pointer;background:repeating-linear-gradient(45deg,transparent,transparent 3px,rgba(11,37,64,.04) 3px,rgba(11,37,64,.04) 6px);}
.cday.beyond:hover{background:var(--og)!important;border-color:var(--mred)!important;color:var(--mred)!important;}
.waitlist-panel{margin-top:20px;background:#fff;border:1px solid rgba(200,16,46,.3);border-radius:var(--rlg);padding:26px;display:none;animation:fi .3s ease both;}
.wl-tabs{display:flex;border-bottom:1px solid var(--line);margin-bottom:22px;}
.wl-tab{padding:10px 18px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;}
.wl-tab.active{color:var(--mred);border-bottom-color:var(--mred);}
.wl-content{display:none;}
.wl-content.active{display:block;}
.tpanel{margin-top:20px;background:#fff;border:1px solid var(--line);border-radius:var(--rlg);padding:24px;display:none;}
.tphead{font-family:'Poppins',sans-serif;font-size:14px;font-weight:600;color:var(--mred);margin-bottom:16px;}
.sgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
.slot{padding:11px 6px;text-align:center;border:1px solid var(--line);border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;color:var(--ink2);background:#fff;}
.slot:hover{border-color:var(--mred);color:var(--mred);}
.slot.sel{background:var(--mred);color:#fff;border-color:var(--mred);}
.slot.bkd{opacity:.35;cursor:not-allowed;text-decoration:line-through;}
.sum-panel{background:#fff;border:1px solid var(--line);border-radius:var(--rlg);padding:26px;position:sticky;top:96px;height:fit-content;box-shadow:var(--shadow);}
.sum-title{font-family:'Poppins',sans-serif;font-size:18px;font-weight:700;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--line);}
.srow{display:flex;justify-content:space-between;align-items:flex-start;padding:11px 0;border-bottom:1px solid var(--line);gap:12px;}
.srow:last-of-type{border-bottom:none;}
.sk{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;flex-shrink:0;}
.sv{font-size:13.5px;font-weight:600;color:var(--ink);text-align:right;}
.stotal{display:flex;justify-content:space-between;align-items:center;margin-top:18px;padding-top:18px;border-top:1px solid var(--line);}
